#!/bin/sh /etc/rc.common
# Temporary package checkpoint; install before package/network changes.
START=99
USE_PROCD=1
start_service() {
    procd_open_instance
    procd_set_param command /root/wgmvp-packages-before/package-guard.sh watch
    procd_set_param respawn 3600 3 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
