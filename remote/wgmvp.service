[Unit]
Description=Restricted WireGuard MVP lease and namespace controller
After=network.target
Before=shutdown.target
ConditionPathExists=/etc/wgmvp/config.env

[Service]
Type=simple
ExecStart=/etc/wgmvp/controller.sh watch
ExecStop=/etc/wgmvp/controller.sh stop
Restart=on-failure
RestartSec=3s
TimeoutStopSec=50s
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
