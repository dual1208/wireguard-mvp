#!/bin/sh /etc/rc.common
# Keep network.wgmvp.auto=0: this service orders guards before router_start/ifup.
START=99
STOP=89
USE_PROCD=1

start_service() {
    [ -x /etc/wgmvp/controller.sh ] || return 1
    procd_open_instance
    procd_set_param command /etc/wgmvp/controller.sh watch
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /etc/wgmvp/controller.sh stop
}
